{
  "App": {
    "SelfUrl": "https://localhost:44300",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.AbpDemo.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=AbpDemo;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44300",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "AbpDemo_Swagger",
    "CertificatePassPhrase": "6bc28c30-16d0-4162-895d-eb283d6b0cdc"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "USxRuRjl2RLauGk4"
  }}